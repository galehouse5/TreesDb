# TreesDb web/ — environment variables (P0-01)
# Copy to .env.local and fill in. NEVER commit real secrets or production connection strings.

# --- Database (Postgres on Neon) ---
# Local dev: a local Postgres URL, e.g. postgres://postgres:postgres@localhost:5432/treesdb
# Prod/preview: the Neon pooled connection string.
DATABASE_URL=

# --- Photo storage (Vercel Blob, D-022) ---
# Vercel injects this into the project from the connected Blob store
# ("treesdb-photos"); `vercel env pull .env.local` copies it for local use.
# Leave empty locally and in CI: photo reads then fall back to the legacy
# placeholder icon and uploads report that storage isn't configured.
BLOB_READ_WRITE_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Auth (Auth.js / NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Legacy system (parity capture + redirects) ---
LEGACY_BASE_URL=http://treesdb.org

# --- Error tracking (Sentry) ---
# Server-side error reports (the ELMAH replacement). Leave empty locally and in
# CI: with no DSN, Sentry is never initialized and nothing is sent. In Vercel,
# set it for Production (and Preview if wanted) from the Sentry project's
# Settings > Client Keys (DSN). See lib/sentry.ts.
SENTRY_DSN=
# Optional: overrides the environment tag (defaults to VERCEL_ENV, then NODE_ENV).
SENTRY_ENVIRONMENT=
