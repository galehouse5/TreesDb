# TreesDb web/ — environment variables (P0-01)
# Copy to .env.local and fill in. NEVER commit real secrets or production connection strings.

# --- Database (Postgres on Neon) ---
# Local dev: a local Postgres URL, e.g. postgres://postgres:postgres@localhost:5432/treesdb
# Prod/preview: the Neon pooled connection string.
DATABASE_URL=

# --- Photo storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Auth (Auth.js / NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Legacy system (parity capture + redirects) ---
LEGACY_BASE_URL=http://treesdb.org

# --- Error tracking (Sentry) ---
SENTRY_DSN=
